<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-link-transaction-category" author="bexultan">
        <!-- Очищаем старые данные, чтобы не возникло конфликта с NOT NULL для category_id -->
        <delete tableName="transactions"/>

        <!-- Удаляем старую текстовую колонку -->
        <dropColumn tableName="transactions" columnName="category"/>

        <!-- Добавляем колонку category_id с внешним ключом на таблицу categories -->
        <addColumn tableName="transactions">
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_transactions_category_id"
                             references="categories(id)"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>